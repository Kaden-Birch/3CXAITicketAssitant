                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "greeting": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8000
                  },
                  "maxQuestions": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 20
                  },
                  "requireConfirmation": {
                    "type": "boolean",
                    "const": true
                  },
                  "vadEagerness": {
                    "default": "medium",
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "noiseReduction": {
                    "default": "far_field",
                    "type": "string",
                    "enum": [
                      "far_field",
                      "near_field",
                      "off"
                    ]
                  },
                  "interruptionEnabled": {
                    "default": true,
                    "type": "boolean"
                  },
                  "ticketCreationEnabled": {
                    "default": true,
                    "type": "boolean"
                  },
                  "retentionDays": {
                    "default": 30,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 365
                  },
                  "diagnosticLogging": {
                    "default": true,
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "greeting",
                  "prompt",
                  "maxQuestions",
                  "requireConfirmation",
                  "vadEagerness",
                  "noiseReduction",
                  "interruptionEnabled",
                  "ticketCreationEnabled",
                  "retentionDays",
                  "diagnosticLogging"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
