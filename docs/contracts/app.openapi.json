    "/api/settings/connections": {
      "get": {
        "summary": "Masked metadata; no secret values",
        "x-access-role": "admin",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful result; inspect docs/api-contracts.md for response shape"
          },
          "default": {
            "description": "Sanitized error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Save settings and optional write-only secret",
        "x-access-role": "admin",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must equal APP_ORIGIN exactly"
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful result; inspect docs/api-contracts.md for response shape"
          },
          "default": {
            "description": "Sanitized error envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "const": "pbx"
                      },
                      "pbxBase": {
                        "type": "string",
                        "maxLength": 250
                      },
                      "appId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "^[a-zA-Z0-9_-]+$"
                      },
                      "targetVersion": {
                        "type": "string",
                        "const": "20 Update 10"
                      },
                      "supportExtension": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^\\d{2,8}$"
                          },
                          {
                            "type": "string",
                            "const": ""
                          }
                        ]
                      },
                      "secret": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "provider",
                      "pbxBase",
                      "appId",
                      "targetVersion",
                      "supportExtension"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "const": "openai"
                      },
                      "model": {
                        "type": "string",
                        "maxLength": 100,
                        "pattern": "^[a-zA-Z0-9._-]*$"
                      },
                      "voice": {
                        "type": "string",
                        "maxLength": 40,
                        "pattern": "^[a-zA-Z0-9_-]*$"
                      },
                      "secret": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "provider",
                      "model",
                      "voice"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "const": "syncro"
                      },
                      "tenant": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                      },
                      "secret": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "provider",
                      "tenant"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        }
      }
    },
