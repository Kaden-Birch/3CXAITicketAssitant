                  "email": {
                    "type": "string",
                    "maxLength": 200,
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 14,
                    "maxLength": 128
                  },
                  "bootstrapToken": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password",
                  "bootstrapToken"
                ],
                "additionalProperties": false
