# This file contains examples only. Pass these variables to your process/Compose.
DEMO_MODE=true
APP_ORIGIN=http://localhost:3000
HOST=127.0.0.1
PORT=3000
DATA_DIR=.data
# Required for non-demo installations. Generate a random 32-byte hex key locally.
MASTER_ENCRYPTION_KEY=

# Explicit browser tests may use saved provider keys even with seeded demo history.
BROWSER_DEMO_CALLS=true
